#!/usr/bin/env python3
"""
Xray Terminal Proxy Manager (XHM)
Interactive terminal interface and CLI to switch, toggle, and monitor proxy configs.
"""

import argparse
import curses
import os
import re
import signal
import subprocess
import sys
import time
import unicodedata

# --- Core Proxy Manager (Delegated to XHM Core Engine) ---
_LOCAL_REPO_LIB = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
_USER_LIB = os.path.expanduser("~/.local/lib")
for _lib_dir in (_LOCAL_REPO_LIB, _USER_LIB):
    if os.path.isdir(_lib_dir) and _lib_dir not in sys.path:
        sys.path.append(_lib_dir)

import xhm_core

ProxyManager = xhm_core.ProxyManager
format_duration = xhm_core.format_duration
get_gnome_proxy_state = xhm_core.get_gnome_proxy_state
set_gnome_proxy = xhm_core.set_gnome_proxy
test_tcp_ping = xhm_core.test_tcp_ping
load_nodes = xhm_core.load_all_nodes


_TERM_EMOJI_RE = re.compile(r"[\U0001F300-\U0001FAFF\u2600-\u27BF\uFE0E\uFE0F]")


def _sanitize_term_msg(text: str) -> str:
    """Strip color/status emojis that render as tofu boxes in fallback terminal fonts."""
    if not text:
        return ""
    return " ".join(_TERM_EMOJI_RE.sub("", str(text)).split())


def _char_cols(ch: str) -> int:
    cp = ord(ch)
    if unicodedata.combining(ch) or unicodedata.category(ch) == "Cf" or 0xFE00 <= cp <= 0xFE0F:
        return 0
    if unicodedata.east_asian_width(ch) in ("F", "W") or cp >= 0x1F000:
        return 2
    return 1


def _display_width(text: str) -> int:
    return sum(_char_cols(ch) for ch in text)


def safe_clip(text: str, max_cols: int) -> str:
    """Safely clip string considering wide, combining, and zero-width characters."""
    if max_cols <= 0:
        return ""
    cols = 0
    res = []
    for ch in text:
        w = _char_cols(ch)
        if w > 0 and cols + w > max_cols:
            break
        res.append(ch)
        cols += w
    return "".join(res)


def _key_is(key, *targets) -> bool:
    for t in targets:
        if key == t:
            return True
        if isinstance(t, str) and len(t) == 1 and isinstance(key, int) and key == ord(t):
            return True
        if isinstance(t, int) and isinstance(key, str) and len(key) == 1 and ord(key) == t:
            return True
    return False


def _read_tui_key(stdscr):
    try:
        if hasattr(stdscr, "get_wch"):
            return stdscr.get_wch()
        ch = stdscr.getch()
        return None if ch == -1 else ch
    except curses.error:
        return None


def _ping_sni_for_node(node: dict) -> str:
    ptype = str(node.get("type") or "").lower()
    raw = node.get("raw") if isinstance(node.get("raw"), dict) else node
    if ptype == "ssh":
        cfg_type = str(raw.get("ssh_config_type") or node.get("ssh_config_type") or "")
        sni = str(raw.get("sni") or node.get("sni") or "")
        if cfg_type in ("SSH-TLS", "SSH-SSL") or (sni and sni != str(node.get("server") or "")):
            return sni or str(node.get("server") or "")
        return ""
    tls = raw.get("tls") if isinstance(raw.get("tls"), dict) else {}
    if tls.get("enabled"):
        return str(tls.get("server_name") or node.get("server") or "")
    return ""


# --- Terminal UI (Curses) ---
def draw_ui(stdscr, manager: ProxyManager):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)     # Header / Borders
    curses.init_pair(2, curses.COLOR_GREEN, -1)    # Connected / ON
    curses.init_pair(3, curses.COLOR_RED, -1)      # Disconnected / OFF
    curses.init_pair(4, curses.COLOR_YELLOW, -1)   # Warning / Accent
    curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_CYAN)  # Highlighted item
    curses.init_pair(6, curses.COLOR_WHITE, -1)    # Normal text
    curses.init_pair(7, curses.COLOR_MAGENTA, -1)  # Tags

    stdscr.nodelay(False)
    stdscr.timeout(1000)

    nodes = load_nodes()
    selected_idx = 0
    top_offset = 0
    search_query = ""
    is_searching = False

    # Position on active node if connected
    if manager.connected and manager.active_node:
        for idx, n in enumerate(nodes):
            if xhm_core.is_same_node(n, manager.active_node):
                selected_idx = idx
                break

    def get_filtered_nodes():
        if not search_query:
            return nodes
        q = search_query.lower()
        return [
            n for n in nodes
            if q in str(n.get("tag") or "").lower()
            or q in str(n.get("type") or "").lower()
            or q in str(n.get("server") or "").lower()
        ]

    cached_update = xhm_core.read_update_cache()

    while True:
        traffic_stats = manager.query_traffic_stats() or {}
        max_y, max_x = stdscr.getmaxyx()
        stdscr.erase()

        filtered_nodes = get_filtered_nodes()
        if selected_idx >= len(filtered_nodes):
            selected_idx = max(0, len(filtered_nodes) - 1)

        # 1. Header Bar
        title = " XHM - PROXY CONTROLLER "
        upd_tag = " [UPDATE AVAILABLE]" if (cached_update and cached_update.get("update_available")) else ""
        header = f"{title}(Nodes: {len(filtered_nodes)}/{len(nodes)}){upd_tag}"
        try:
            stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(0, 0, safe_clip(header, max_x - 1).ljust(max(0, max_x - 1)))
            stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
        except curses.error:
            pass

        # 2. Power Dashboard Card (ON / OFF / Reconnecting / Error + Traffic)
        is_conn = manager.connected
        is_reconn = bool(getattr(manager, "_reconnecting", False))
        clean_msg = _sanitize_term_msg(manager.status_msg or "")
        is_err = (not is_conn) and (not is_reconn) and bool(clean_msg) and any(
            k in clean_msg.lower() for k in ("error", "failed", "fault", "invalid", "cannot", "shutting down", "closed")
        )
        box_width = max(12, min(max_x - 2, 78))

        try:
            stdscr.addstr(1, 1, "┌" + ("─" * (box_width - 2)) + "┐", curses.color_pair(1))

            # Row 1: Big Status Badge
            stdscr.addstr(2, 1, "│", curses.color_pair(1))
            if is_conn:
                status_badge = " [ ON / CONNECTED ] "
                status_attr = curses.color_pair(2) | curses.A_BOLD
            elif is_reconn:
                status_badge = " [ RECONNECTING ] "
                status_attr = curses.color_pair(4) | curses.A_BOLD
            elif is_err:
                status_badge = " [ OFF / ERROR ] "
                status_attr = curses.color_pair(3) | curses.A_BOLD
            else:
                status_badge = " [ OFF / DISCONNECTED ] "
                status_attr = curses.color_pair(3) | curses.A_BOLD
            stdscr.addstr(2, 2, safe_clip(status_badge, max(0, box_width - 28)), status_attr)

            sys_proxy_on = get_gnome_proxy_state()
            tun_on = xhm_core.is_tun_active()
            sys_str = f"Sys:{'ON' if sys_proxy_on else 'OFF'} TUN:{'ON' if tun_on else 'OFF'}"
            sys_attr = (curses.color_pair(2) if (sys_proxy_on or tun_on) else curses.color_pair(4)) | curses.A_BOLD
            if box_width - len(sys_str) - 2 > 28:
                stdscr.addstr(2, box_width - len(sys_str) - 2, sys_str, sys_attr)
            stdscr.addstr(2, box_width, "│", curses.color_pair(1))

            # Row 2: Active Server / Error Summary
            stdscr.addstr(3, 1, "│", curses.color_pair(1))
            if is_conn and manager.active_node:
                uptime = format_duration(int(time.time() - (manager.start_time or time.time())))
                node_info = f"Node: [{str(manager.active_node.get('type') or '').upper()}] {_sanitize_term_msg(manager.active_node.get('tag') or '')}"
                details = f"{node_info} | Ports: {manager.proxy_port}/:{manager.proxy_port + 1} | {uptime}"
                row2_attr = curses.color_pair(6)
            elif is_reconn:
                details = clean_msg or "Reconnecting proxy tunnel in background..."
                row2_attr = curses.color_pair(4)
            elif is_err:
                details = clean_msg
                row2_attr = curses.color_pair(3)
            else:
                details = "Press [Enter/Space] on any server below to connect."
                row2_attr = curses.color_pair(6)
            stdscr.addstr(3, 3, safe_clip(details, max(0, box_width - 4)), row2_attr)
            stdscr.addstr(3, box_width, "│", curses.color_pair(1))

            # Row 3: Live Speed & Session Traffic / Endpoint Info
            stdscr.addstr(4, 1, "│", curses.color_pair(1))
            if is_conn:
                d_spd = traffic_stats.get("down_speed_fmt") or "0 B/s"
                u_spd = traffic_stats.get("up_speed_fmt") or "0 B/s"
                d_tot = traffic_stats.get("down_total_fmt") or "0 B"
                u_tot = traffic_stats.get("up_total_fmt") or "0 B"
                core_lbl = manager.core_name or "Xray Core"
                row3 = f"Traffic: Down {d_spd} ({d_tot}) | Up {u_spd} ({u_tot}) | {core_lbl}"
                row3_attr = curses.color_pair(2)
            else:
                row3 = f"Local Proxy: 127.0.0.1:{manager.proxy_port} (SOCKS5) / :{manager.proxy_port + 1} (HTTP)"
                row3_attr = curses.color_pair(6)
            stdscr.addstr(4, 3, safe_clip(row3, max(0, box_width - 4)), row3_attr)
            stdscr.addstr(4, box_width, "│", curses.color_pair(1))

            # Card Bottom Border
            stdscr.addstr(5, 1, "└" + ("─" * (box_width - 2)) + "┘", curses.color_pair(1))
        except curses.error:
            pass

        # 3. Search Bar
        list_start_y = 7
        if search_query or is_searching:
            try:
                cursor_ch = "|" if is_searching else ""
                prompt = f" / Filter: {search_query}{cursor_ch} "
                stdscr.addstr(6, 2, safe_clip(prompt, max(1, max_x - 3)), curses.color_pair(4) | curses.A_BOLD)
                list_start_y = 8
            except curses.error:
                pass

        # 4. Servers List
        available_lines = max_y - list_start_y - 2
        if available_lines > 0:
            if not filtered_nodes:
                empty_hint = (
                    "  No matching servers — press [Esc] to clear filter."
                    if search_query
                    else "  No proxy configs loaded — press [r] to reload."
                )
                try:
                    stdscr.addstr(list_start_y, 1, safe_clip(empty_hint, max(1, max_x - 3)), curses.color_pair(4))
                except curses.error:
                    pass
            else:
                if selected_idx < top_offset:
                    top_offset = selected_idx
                elif selected_idx >= top_offset + available_lines:
                    top_offset = selected_idx - available_lines + 1

                for i in range(available_lines):
                    node_idx = top_offset + i
                    if node_idx >= len(filtered_nodes):
                        break
                    curr_node = filtered_nodes[node_idx]
                    y = list_start_y + i

                    is_selected = (node_idx == selected_idx)
                    is_active = manager.connected and xhm_core.is_same_node(curr_node, manager.active_node)

                    mark = "* " if is_active else "  "
                    proto_badge = f"[{str(curr_node.get('type') or '').upper():5}]"
                    ping_val = curr_node.get("ping")
                    ping_str = f"[{ping_val}ms]" if ping_val is not None else ""
                    tag_str = _sanitize_term_msg(str(curr_node.get("tag") or ""))
                    srv_str = f"({curr_node.get('server') or ''}:{curr_node.get('port') or 0})"

                    line_content = f" {mark}{proto_badge} {tag_str} {srv_str} {ping_str}"
                    line_display = safe_clip(line_content, max(1, max_x - 4))

                    attr = curses.color_pair(5) if is_selected else (curses.color_pair(2) if is_active else curses.color_pair(6))
                    if is_active:
                        attr |= curses.A_BOLD

                    try:
                        stdscr.addstr(y, 1, line_display, attr)
                    except curses.error:
                        pass

        # 5. Status / Message Line
        status_line_y = max_y - 2
        if clean_msg:
            msg_attr = curses.color_pair(3) if is_err else curses.color_pair(4)
            try:
                stdscr.addstr(status_line_y, 1, safe_clip(f" {clean_msg} ", max(1, max_x - 2)), msg_attr)
            except curses.error:
                pass

        # 6. Bottom Keybindings Bar
        footer_y = max_y - 1
        footer_text = " [Enter/Space] Toggle  [d] Off  [s] SysProxy  [u] TUN  [t] Ping  [/] Filter  [q] Exit"
        try:
            stdscr.attron(curses.color_pair(1) | curses.A_REVERSE)
            stdscr.addstr(footer_y, 0, safe_clip(footer_text, max(1, max_x - 1)).ljust(max(0, max_x - 1)))
            stdscr.attroff(curses.color_pair(1) | curses.A_REVERSE)
        except curses.error:
            pass

        stdscr.refresh()

        # Handle user input (supports UTF-8/Persian search via get_wch)
        key = _read_tui_key(stdscr)
        if key is None:
            continue

        if is_searching:
            if _key_is(key, "\n", "\r"):
                is_searching = False
            elif _key_is(key, "\x1b"):
                is_searching = False
                search_query = ""
            elif _key_is(key, curses.KEY_BACKSPACE, "\x7f", "\b"):
                search_query = search_query[:-1]
                selected_idx = 0
            else:
                char_in = key if isinstance(key, str) else (chr(key) if isinstance(key, int) and 32 <= key <= 126 else "")
                if char_in and char_in.isprintable():
                    search_query += char_in
                    selected_idx = 0
            continue

        # Navigation
        if _key_is(key, curses.KEY_UP, "k", "K"):
            if selected_idx > 0:
                selected_idx -= 1
        elif _key_is(key, curses.KEY_DOWN, "j", "J"):
            if selected_idx < len(filtered_nodes) - 1:
                selected_idx += 1
        elif _key_is(key, curses.KEY_PPAGE):
            selected_idx = max(0, selected_idx - 10)
        elif _key_is(key, curses.KEY_NPAGE):
            selected_idx = min(max(0, len(filtered_nodes) - 1), selected_idx + 10)

        # Actions
        elif _key_is(key, "\n", "\r", " "):  # Enter or Space: Toggle ON / OFF or Switch
            if filtered_nodes:
                target_node = filtered_nodes[selected_idx]
                manager.toggle(target_node)

        elif _key_is(key, "d", "D", "x", "X"):  # Explicit Disconnect (Turn OFF)
            manager.stop()

        elif _key_is(key, "s", "S", "p", "P"):  # Toggle GNOME System Proxy
            cur_state = get_gnome_proxy_state()
            set_gnome_proxy(not cur_state, manager.proxy_port, http_port=manager.proxy_port + 1)
            manager.status_msg = f"System proxy set to {'ON' if not cur_state else 'OFF'}"

        elif _key_is(key, "u", "U"):  # Toggle TUN Mode
            cur_tun = xhm_core.is_tun_active()
            ok_tun, msg_tun = xhm_core.set_tun_mode_detailed(not cur_tun, manager=manager)
            manager.status_msg = msg_tun if ok_tun else f"[!] {msg_tun}"

        elif _key_is(key, "r", "R"):  # Reload
            nodes = load_nodes()
            manager.status_msg = f"Reloaded {len(nodes)} valid nodes."
            selected_idx = 0

        elif _key_is(key, "/"):  # Search
            is_searching = True
            search_query = ""

        elif _key_is(key, "t", "T"):  # Ping
            if filtered_nodes:
                target = filtered_nodes[selected_idx]
                srv = str(target.get("server") or "")
                prt = int(target.get("port") or 0)
                manager.status_msg = f"Testing ping to {srv}..."
                stdscr.refresh()
                sni = _ping_sni_for_node(target) or None
                latency = test_tcp_ping(srv, prt, sni=sni)
                target["ping"] = latency
                manager.status_msg = f"Ping {srv}: {latency}ms" if latency is not None else f"Ping timeout: {srv}"

        elif _key_is(key, "\x1b"):
            if search_query:
                search_query = ""
                selected_idx = 0
            else:
                break

        elif _key_is(key, "q", "Q"):  # Exit TUI
            # Clean exit keeping background daemon running!
            break


# --- CLI Commands Handler ---
def handle_cli_args(args, manager: ProxyManager):
    """Handle non-interactive command line subcommands."""
    cmd = args.command.lower() if args.command else None

    if cmd in ("status", "info"):
        traffic = manager.query_traffic_stats() or {}
        meta = xhm_core.get_installed_meta()
        cached_update = xhm_core.read_update_cache()
        ver_str = f"{meta['version']} ({meta['short_commit']})" if meta.get("short_commit") else meta["version"]
        print("\n" + "=" * 54)
        print("XHM - Proxy Status")
        print("=" * 54)
        print(f"Version:      {ver_str}")
        if cached_update and cached_update.get("update_available"):
            latest_s = cached_update.get("latest_short") or "new"
            print(f"Update:       [NEW] Upstream {latest_s} available -> run 'xhm update'")
        if manager.connected and manager.active_node:
            uptime = format_duration(int(time.time() - (manager.start_time or time.time())))
            print("Status:       [ON] Connected")
            print(f"Server Name:  {manager.active_node.get('tag')}")
            print(f"Protocol:     {manager.active_node.get('type', '').upper()}")
            print(f"Endpoint:     {manager.active_node.get('server')}:{manager.active_node.get('port')}")
            print(f"Local Proxy:  127.0.0.1:{manager.proxy_port} (SOCKS5) / :{manager.proxy_port + 1} (HTTP)")
            print(f"Traffic:      Down {traffic.get('down_total_fmt', '0 B')} ({traffic.get('down_speed_fmt', '0 B/s')}) | Up {traffic.get('up_total_fmt', '0 B')} ({traffic.get('up_speed_fmt', '0 B/s')})")
            print(f"System Proxy: {'ENABLED' if get_gnome_proxy_state() else 'DISABLED'}")
            print(f"TUN Mode:     {'ENABLED (xhm-tun)' if xhm_core.is_tun_active() else 'DISABLED'}")
            print(f"Core Engine:  {manager.core_name or 'Xray Core'}")
            print(f"Uptime:       {uptime}")
        else:
            print("Status:       [OFF] Disconnected")
            if getattr(manager, "status_msg", ""):
                clean_msg = _sanitize_term_msg(manager.status_msg)
                if clean_msg:
                    print(f"Message:      {clean_msg}")
            print(f"Local Ports:  127.0.0.1:{manager.proxy_port} (SOCKS5) / :{manager.proxy_port + 1} (HTTP)")
            print(f"System Proxy: {'ENABLED' if get_gnome_proxy_state() else 'DISABLED'}")
            print(f"TUN Mode:     {'ENABLED (xhm-tun)' if xhm_core.is_tun_active() else 'DISABLED'}")
        print("=" * 54 + "\n")
        sys.exit(0)

    elif cmd in ("off", "stop", "disconnect", "kill"):
        print("Stopping proxy connection...")
        manager.stop()
        print("[OFF] Proxy turned OFF. GNOME system proxy disabled.")
        sys.exit(0)

    elif cmd in ("on", "start", "connect"):
        nodes = load_nodes()
        if not nodes:
            print("[!] No valid nodes found.")
            sys.exit(1)

        target = nodes[0]
        if args.target:
            q = args.target.lower()
            matches = [
                n for n in nodes
                if q in str(n.get("tag") or "").lower() or q in str(n.get("server") or "").lower()
            ]
            if not matches:
                print(f"[!] No server matched '{args.target}'. Run 'xhm list' to view available servers.")
                sys.exit(1)
            target = matches[0]

        print(f"Connecting to [{str(target.get('type') or '').upper()}] {target.get('tag')} ({target.get('server')}:{target.get('port')})...")
        if manager.start(target):
            print(f"[ON] Connected! SOCKS5: 127.0.0.1:{manager.proxy_port} | HTTP: 127.0.0.1:{manager.proxy_port + 1}")
            print("System proxy enabled.")
        else:
            err = _sanitize_term_msg(manager.status_msg)
            print(f"[!] Failed to connect: {err}" if err else "[!] Failed to connect.")
            sys.exit(1)
        sys.exit(0)

    elif cmd == "toggle":
        if manager.connected:
            manager.stop()
            print("[OFF] Disconnected.")
        else:
            nodes = load_nodes()
            if not nodes:
                print("[!] No nodes available.")
                sys.exit(1)
            if manager.start(nodes[0]):
                print(f"[ON] Connected to {nodes[0].get('tag', '')}.")
            else:
                err = _sanitize_term_msg(manager.status_msg)
                print(f"[!] Failed to connect: {err}" if err else "[!] Failed to connect.")
                sys.exit(1)
        sys.exit(0)

    elif cmd in ("list", "ls"):
        nodes = load_nodes()
        print(f"\nAvailable Nodes ({len(nodes)}):")
        print("-" * 60)
        for i, n in enumerate(nodes, 1):
            active_mark = "* (ON)" if manager.connected and xhm_core.is_same_node(n, manager.active_node) else ""
            print(f"{i:2d}. [{str(n.get('type') or '').upper():5}] {n.get('tag', '')} ({n.get('server', '')}:{n.get('port', 0)}) {active_mark}")
        print("-" * 60 + "\n")
        sys.exit(0)

    elif cmd in ("tun", "vpn"):
        sub = args.target.lower() if args.target else "toggle"
        target_state = (
            True if sub in ("on", "start", "enable")
            else False if sub in ("off", "stop", "disable")
            else not xhm_core.is_tun_active()
        )
        ok, msg = xhm_core.set_tun_mode_detailed(target_state, manager=manager)
        clean_msg = _sanitize_term_msg(msg)
        if ok:
            print(f"{'[ON]' if target_state else '[OFF]'} {clean_msg}")
            sys.exit(0)
        else:
            print(f"[!] {clean_msg}")
            sys.exit(1)

    elif cmd in ("gui", "web"):
        gui_bin = os.path.expanduser("~/.local/bin/xhm-gui")
        if os.path.exists(gui_bin) and os.access(gui_bin, os.X_OK):
            subprocess.Popen([gui_bin], start_new_session=True)
            print("Launched XHM GUI.")
        else:
            import webbrowser
            webbrowser.open("http://127.0.0.1:18501")
            print("Opened http://127.0.0.1:18501")
        sys.exit(0)

    elif cmd == "update":
        check_only = bool(getattr(args, "check", False)) or (str(args.target or "").lower() == "check")
        proxy_port = (manager.proxy_port + 1) if manager.connected else None
        info = xhm_core.check_for_updates(force=True, http_proxy_port=proxy_port)
        ver_str = f"{info.get('installed_version', '1.0.0')}"
        if info.get("installed_short"):
            ver_str += f" ({info['installed_short']})"

        if check_only:
            print(f"Installed: {ver_str}")
            if info.get("latest_short"):
                print(f"Upstream:  {info.get('branch', 'main')} ({info['latest_short']})")
            if info.get("commit_message"):
                print(f"Latest:    {info['commit_message']}")
            if info.get("update_available"):
                print("[UPDATE] A newer Git revision is available. Run 'xhm update' to upgrade.")
            elif info.get("error"):
                print(f"[!] Check warning: {info['error']}")
            else:
                print("[OK] XHM is up to date.")
            sys.exit(0)

        if info.get("error") and not info.get("update_available"):
            print(f"[!] Could not verify upstream Git status: {info['error']}")
            sys.exit(1)

        if not info.get("update_available"):
            print(f"[OK] XHM is already up to date ({ver_str}).")
            sys.exit(0)

        res = xhm_core.apply_git_update(http_proxy_port=proxy_port)
        print(res.get("message") or ("Updated." if res.get("success") else "Update failed."))
        if not res.get("success") and res.get("update_command"):
            print(f"Manual update: {res['update_command']}")
        sys.exit(0 if res.get("success") else 1)


def main():
    parser = argparse.ArgumentParser(description="Xray Terminal Proxy Manager (XHM)")
    parser.add_argument("command", nargs="?", choices=["on", "off", "toggle", "status", "list", "stop", "start", "gui", "web", "tun", "vpn", "update"], help="CLI command")
    parser.add_argument("target", nargs="?", help="Server name or IP for 'on' command")
    parser.add_argument("--check", action="store_true", help="Check upstream Git updates without modifying files")
    args = parser.parse_args()

    manager = ProxyManager()

    if args.command:
        handle_cli_args(args, manager)
        return

    # Non-destructive signal handling
    def sig_handler(sig, frame):
        # On Ctrl+C, exit curses without terminating the background proxy!
        try:
            curses.endwin()
        except Exception:
            pass
        if manager.connected:
            print("\n[ON] xhm exited: Proxy continues running in background.")
            print("     Run 'xhm off' to disconnect, or 'xhm' to return to menu.\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    try:
        curses.wrapper(lambda stdscr: draw_ui(stdscr, manager))
    finally:
        pass

    # Print user-friendly daemon status after exiting TUI
    if manager.connected and manager.active_node:
        print("\n" + "=" * 55)
        print("[ON] xhm is running in background (Daemon Mode)")
        print(f"     Node:         [{manager.active_node.get('type','').upper()}] {manager.active_node.get('tag')}")
        print(f"     Proxy Ports:  127.0.0.1:{manager.proxy_port} (SOCKS5) / :{manager.proxy_port + 1} (HTTP)")
        print(f"     System Proxy: {'ENABLED' if get_gnome_proxy_state() else 'DISABLED'}")
        print("     Commands:")
        print("       xhm         -> Reopen interactive menu")
        print("       xhm off     -> Disconnect & turn off")
        print("       xhm status  -> Check connection info")
        print("=" * 55 + "\n")


if __name__ == "__main__":
    main()
